NODE_ENV=development
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# chat persistence -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# episteme-core (Mastra REST API)
MASTRA_BASE_URL=http://localhost:4111
MASTRA_AGENT_ID=episteme-chat-agent
# Shared secret for admin KB operations AND the /chat proxy (required — chat
# requests without it are rejected by episteme-core). Must match
# MASTRA_ADMIN_KEY in episteme-core.
MASTRA_ADMIN_KEY=

# Supabase Integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for OAuth redirects in some environments (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=***************

# ── NOT needed here — set these elsewhere ────────────────────────────────────
# EPISTEME_CRON_SECRET   → Supabase Edge Function secret (freshness-guardian)
#                          + DB: ALTER DATABASE postgres SET app.freshness_cron_secret = '...';
# EPISTEME_CRON_SECRET   is NOT read by the Next.js app — do not add it to .env.local
