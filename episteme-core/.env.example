MISTRAL_API_KEY=
PORT=4111
# Shared secret for admin KB API routes, claimStatusTool, AND the /chat
# endpoint (chat-security middleware rejects requests without it).
# Must match MASTRA_ADMIN_KEY in episteme-chat.
MASTRA_ADMIN_KEY=
# Base URL of the episteme-chat Next.js server (used by claimStatusTool)
EPISTEME_CHAT_BASE_URL=http://localhost:3000

# Database — LibSQL / Turso
#
# LIBSQL_URL is the DURABLE database and holds the KB document registry
# (kb_documents) ONLY. Nothing on the chat path reads it: if it is unreachable,
# ingestion and the KB admin UI fail and the boot log says so loudly, but chat
# keeps answering. See src/mastra/db.ts.
#
# Local dev: leave LIBSQL_URL unset (defaults to file:./mastra.db) and omit LIBSQL_AUTH_TOKEN
# Production (Vercel): set both to a Turso remote DB
#   turso db create episteme-prod
#   turso db show episteme-prod        → copy URL (libsql://...)
#   turso db tokens create episteme-prod → copy token
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Mastra's own runtime tables (workflow runs, observability traces, scorer
# results). Defaults to a LOCAL file — ./mastra.db in dev, /tmp/mastra.db on
# serverless — and normally needs no value.
#
# It is deliberately local: Mastra persists an agent run BEFORE the first step
# executes, so this store sits in the fatal path of every chat turn. Pointing it
# at a remote host makes that host's availability your chat's availability,
# which is exactly the 2026-08-01 outage. Traces are per-instance in production
# as a result.
# MASTRA_RUNTIME_DB_URL=

# Pinecone vector store
PINECONE_API_KEY=
PINECONE_INDEX=episteme-kb

# Institution the retrieval eval should be able to see (not a secret).
#
# Retrieval always filters institutionId to $in: [caller, __global__]. Documents
# ingested under a real institution UUID are therefore invisible to a caller with
# no institution — every query returns nothing and every abstention case passes
# without testing anything. Discover the right value with:
#   node --env-file=.env.local --import tsx src/evals/run-retrieval-evals.ts --corpus
# EVAL_INSTITUTION_ID=

# Unstructured.io — binary document parsing (PDF, DOCX, HTML, scanned images)
UNSTRUCTURED_API_KEY=

# Tavily — web search fallback for queries not covered by the knowledge base
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning — all have production-calibrated defaults (see config.ts)
# ---------------------------------------------------------------------------

# Chunking
# CHUNK_PARENT_SIZE=2048
# CHUNK_PARENT_OVERLAP=200
# CHUNK_CHILD_SIZE=512
# CHUNK_CHILD_OVERLAP=64
# CHUNK_MIN_CHILD_LENGTH=10

# Embedding
# EMBED_BATCH_SIZE=32

# Ingestion
# PINECONE_UPSERT_BATCH_SIZE=100
# PINECONE_RETRY_ATTEMPTS=3
# PINECONE_RETRY_BASE_DELAY_MS=500

# Retrieval
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.3
# RETRIEVAL_MAX_RESULTS=3
# RETRIEVAL_FRESHNESS_THRESHOLD_DAYS=365
# Measured, not guessed — see config.ts. Was 0.55, which answered 10/10
# out-of-domain probes. Re-measure with: pnpm eval:retrieval --scores
# RETRIEVAL_RELEVANCE_THRESHOLD=0.68

# Reranking — cross-encoder relevance, via Pinecone hosted inference.
#
# TURN THIS ON. Measured on the 454-vector corpus (eval:retrieval, 2026-08-02):
#   without rerank:  abstention 0/4 — every out-of-domain probe was ANSWERED
#                    from the student handbook, including "how do I apply to
#                    Harvard University" and "weather in Benin City"
#   with rerank:     abstention 4/4, and kb-admission-requirements still passes
#
# The embedding threshold alone cannot do this: in-domain (0.694–0.808) and
# out-of-domain (0.611–0.744) scores OVERLAP, so no cutoff separates them.
# A cross-encoder reads query and passage together and scores whether the
# passage answers the question — the signal that does separate them.
#
# Defaults are the measured-good values. Re-calibrate after a large ingest:
#   RERANK_ENABLED=true node --env-file=.env.local --import tsx \
#     src/evals/run-retrieval-evals.ts --scores
# That prints raw cross-encoder scores with no floor applied, so you can see
# whether a rejected query scored 0.28 (lower the floor) or 0.002 (correctly
# rejected — the corpus has no answer, which the web tier then covers).
#
# Fail-soft: a rerank outage falls back to embedding order and still answers.
RERANK_ENABLED=true
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_MIN_SCORE=0.3
# RERANK_TOP_N=10

# Web search
# WEB_SEARCH_MAX_RESULTS=3
# WEB_SEARCH_INCLUDE_DOMAINS=uniben.edu,nuc.edu.ng,jamb.gov.ng,tetfund.gov.ng
# WEB_SEARCH_DEPTH=advanced
# WEB_SEARCH_SCORE_THRESHOLD=0.5

MASTRA_AUTO_REFRESH_PROVIDERS=false
AI_SDK_LOG_WARNINGS=false

UNIBEN_NEWS_CLOUDFLARE_WORKER_URL=https://uniben-news-proxy.your-subdomain.workers.dev
UNIBEN_NEWS_CLOUDFLARE_PROXY_SECRET=